# Virtual environments
venv/
ven/
ENV/
.venv/

# Environment files (secrets set in Liara dashboard)
.env
.env.local

# Logs, caches and temp files — at every depth (a bare pattern only matches
# the context root, so models/.DS_Store or processing/__pycache__/ got copied)
**/logs/
**/temp/
**/*.log
**/__pycache__/
**/*.pyc
**/.pytest_cache/

# IDE
.vscode/
.idea/

# Git
.git/
.gitignore

# OS
**/.DS_Store
**/Thumbs.db

# Local model rollback copies (see .gitignore)
models/backup_*/
