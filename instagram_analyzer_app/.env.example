# Copy to .env at the repo root (next to docker-compose.yml).

# ----- Web -----
SECRET_KEY=change-me-to-a-random-string-at-least-16-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me

# ----- Database -----
DATABASE_URL=postgresql://analyzer:analyzer@postgres:5432/instagram_analyzer

# ----- Redis / Celery -----
REDIS_URL=redis://redis:6379/0

# ----- OCR -----
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.8-max

# ----- Liara S3 (optional) -----
LIARA_ENDPOINT=
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_BUCKET_NAME=

# ----- Storage paths (defaults are fine inside Docker) -----
# UPLOAD_DIR=/tmp/uploads
# PROCESSING_DIR=/tmp/processing
# LOG_DIR=/tmp/logs

# MinIO auto-ingest — fill all four to enable the poller.
# Watches <bucket>/incoming/<company>/<campaign>/<product>/<file>
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
# MINIO_POLL_INTERVAL_SECONDS=60
